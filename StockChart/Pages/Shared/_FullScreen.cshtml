<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">

@{
    if (!ViewData.ContainsKey("LastDate") || ViewData["LastDate"] == null)
        ViewData["LastDate"] = (DateTime.Now.ToString("dd.MM.yyyy"));
    var isEmbed = ViewData["Embed"] as bool? ?? false;
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=0.75">
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    </head>
<body class="@(isEmbed ? "embed-mode" : string.Empty)" ng-app="myApp" ng-controller="ExampleController">
    <!-- Yandex.Metrika counter -->
    <noscript><div><img src="https://mc.yandex.ru/watch/16829734" alt="" /></div></noscript> <!-- /Yandex.Metrika counter -->
    @if (!isEmbed)
    {
        <div>
            <partial name="MainMenu" />
        </div>
    }
    <div id="content">
        <div>
            @RenderBody()
        </div>
    </div>
</body>
</html>

