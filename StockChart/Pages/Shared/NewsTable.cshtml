@model NewsTableModel
<table class="grayblock">
    <tbody>
        <tr>
            <td class="corn_lt"><div class="border" /></td>
            <td class="corn_ct"><div class="border" /></td>
            <td class="corn_rt"><div class="border" /></td>
        </tr>

        <tr>
            <td class="corn_lm"><div class="border" /></td>
            <td class="corn_content" valign="top">
                <div>
                    <h3 class="blockheader"><a href="/ServiceNews/Blogs">ЛЕНТА БЛОГОВ</a></h3>
                    <div class="clear"></div>
                    <div class="line"></div>
                    <div>
                        <div class="tabs_box visible">
                            <table cellspacing="0" cellpadding="4" border="0">
                                <tbody>
                                    @foreach (var item in Model.Blogs())
                                    {
                                        <tr valign="top">
                                            <td><b>@item.Date</b> </td>
                                            <td><a href="/ServiceNews/Content/@item.Slug" class="newslink">@item.Header<i>@(item.CommentCount > 0 ? $"({item.CommentCount} отв.)" : "")</i> </a></td>
                                            <td>@item.Author</td>

                                        </tr>
                                    }
                                    <tr>
                                        <td colspan="2">
                                            <a asp-page="/ServiceNews/Index" title="Все блоги">Все блоги<img src="/images/corner.gif" width="7" height="7" alt="Все новости"></a>
                                            @if (User.Identity.IsAuthenticated)
                                            {
                                                <span>|</span>
                                                <a asp-page="/ServiceNews/Create">Написать</a>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </td>
            <td class="corn_rm"></td>
        </tr>
        <tr><td class="corn_lb"></td><td class="corn_cb"></td><td class="corn_rb"></td></tr>
    </tbody>
</table>


