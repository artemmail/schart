@page "{Id}"
@model DeleteCommentModel
@{
    ViewData["Title"] = "Удалить комментарий";
}
<div class="widerightsidebar">
    <div class="block">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div>
                <H2>Удалить комментарий "@Model.Text"?</H2>
                <p>
                    <input type="submit" value="Удалить" class="k-button" />
                    <a asp-page="/ServiceNews/Details" asp-route-Id="@Model.TopicId" class="k-button">Отмена</a>
                </p>
            </div>
        }
    </div>
</div>


