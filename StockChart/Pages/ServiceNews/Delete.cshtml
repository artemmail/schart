@page "{Id}"
@model DeleteModel
@{
    ViewData["Title"]="Удалить тему";
}
<div class="widerightsidebar">
    <div class="block">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div>
                <H2>Удалить тему "@Model.Header"?</H2>
                <p>
                    <input type="submit" value="Удалить" class="k-button" />
                    <a asp-page="/ServiceNews/Details" asp-route-Id="@Model.Id" class="k-button">Отмена</a>
                </p>
            </div>
        }
    </div>
</div>


